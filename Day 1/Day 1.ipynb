   "source": [
    "# Create simple DataFrame\n",
    "data = [(\"iPhone\", 999), (\"Samsung\", 799), (\"MacBook\", 1299)]\n",
    "df = spark.createDataFrame(data, [\"product\", \"price\"])\n",
    "df.show()\n",
    "\n",
    "# Filter expensive products\n",
    "df.filter(df.price > 1000).show()"
   ]
